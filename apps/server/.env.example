# Dishboard server config — copy to .env (not committed) and fill in.

# Bind host/port. PORT 80 needs root on Linux; 3000 is the dev default.
HOST=0.0.0.0
PORT=3000

# Where the SQLite database lives. Defaults to <repo-root>/data/dishboard.db.
# DATA_DIR=/var/lib/dishboard
# DB_PATH=/var/lib/dishboard/dishboard.db

# Admin credentials. Generate the bcrypt hash with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "yourpassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Cookie signing secret. Set to a stable value in production so sessions
# survive server restarts. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Set to true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Session lifetime in seconds. Default = 8 hours.
SESSION_TIMEOUT_SEC=28800

# Square sync interval in milliseconds. Default = 5 minutes.
# The Square access token itself is stored in the database (set it from the
# editor's Integrations page), not in env.
SQUARE_SYNC_INTERVAL_MS=300000
