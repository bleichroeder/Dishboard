# Copy to .env.local (gitignored) for dev.
#
# Where vite should proxy /api and /health calls. Point this at wherever
# your server is actually running. Default is http://localhost:3000;
# override if your server is on a different port (e.g. 3001 on Windows
# machines where 3000 is reserved by svchost).
VITE_SERVER_URL=http://localhost:3000
